#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        ipad_maximize: ipad_maximize {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp CAPSLOCK>;

            label = "IPAD_MAXIMIZE";
        };

        ipad_left_snap: ipad_left_snap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp LS(LC(LEFT))>,
                <&macro_release>,
                <&kp CAPSLOCK>;

            label = "IPAD_LEFT_SNAP";
        };

        ipad_right_snap: ipad_right_snap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp LS(LC(RIGHT))>,
                <&macro_release>,
                <&kp CAPSLOCK>;

            label = "IPAD_RIGHT_SNAP";
        };

        spotlight: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LG(SPACE) &kp LANG2>;

            label = "NEW_MACRO";
        };

        ipad_control_window: ipad_control_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPS>,
                <&macro_tap>,
                <&kp UP>,
                <&macro_release>,
                <&kp CAPS>;

            label = "IPAD_CONTROL_WINDOW";
        };

        ipad_left_switch: ipad_left_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPS>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp CAPS>;

            label = "IPAD_LEFT_SWITCH";
        };

        ipad_right_switch: ipad_right_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPS>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp CAPS>;

            label = "IPAD_RIGHT_SWITCH";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&ipad_maximize>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&lt 4 Q  &kp W      &kp E               &kp R      &kp T      &kp Y               &kp U               &kp I                  &kp O      &lt 4 P
&kp A    &lt 3 S    &lt 2 D             &lt 1 F    &kp G      &kp H               &lt 1 J             &lt 2 K                &lt 3 L    &kp BACKSPACE
&kp Z    &kp X      &kp C               &kp V      &kp B      &mkp MB1            &kp SLASH           &kp N                  &kp M      &kp COMMA
&kp DOT  &kp MINUS  &mt LEFT_SHIFT TAB  &kp LCTRL  &kp SPACE  &mt LEFT_GUI LANG2  &mt LEFT_ALT LANG1  &mt RIGHT_SHIFT ENTER  &kp GRAVE  &kp ESCAPE
            >;
        };

        nums {
            bindings = <
&kp LS(LG(NUMBER_3))  &kp LC(LEFT)  &kp UP          &kp LC(RIGHT)  &kp LC(UP_ARROW)  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3
&kp LS(LG(NUMBER_4))  &kp LEFT      &kp DOWN        &kp RIGHT      &kp LC(DOWN)      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NUMBER_4   &kp NUMBER_5  &kp NUMBER_6
&kp LS(LG(NUMBER_5))  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3      &mkp MB2              &kp EQUAL              &kp SEMICOLON  &kp SQT       &kp NUMBER_7
&kp NUMBER_8          &kp NUMBER_9  &kp LEFT_SHIFT  &kp LCTRL      &spotlight        &kp LEFT_GUI          &kp LEFT_ALT           &kp LA(SPACE)  &kp NUMBER_0  &kp BACKSLASH
            >;
        };

        symbols {
            bindings = <
&trans        &trans                &trans          &trans     &trans                &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION        &kp AT_SIGN            &kp HASH
&trans        &kp LEFT              &trans          &kp RIGHT  &trans                &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR             &kp PERCENT            &kp CARET
&trans        &trans                &trans          &trans     &trans                &trans                &kp PLUS               &kp COLON              &kp DOUBLE_QUOTES      &kp AMPERSAND
&kp ASTERISK  &kp LEFT_PARENTHESIS  &kp LEFT_SHIFT  &kp LCTRL  &kp LG(LEFT_BRACKET)  &kp LEFT_GUI          &kp LEFT_ALT           &kp LG(RIGHT_BRACKET)  &kp RIGHT_PARENTHESIS  &kp PIPE
            >;
        };

        screen {
            bindings = <
&trans         &ipad_left_switch  &ipad_control_window  &ipad_right_switch  &trans         &kp LA(LC(O))     &kp LA(LC(Z))  &kp LA(LC(X))       &kp LA(LC(C))  &trans
&trans         &ipad_left_snap    &ipad_maximize        &ipad_right_snap    &trans         &kp LA(LC(LEFT))  &kp LC(LA(J))  &kp LA(LC(L))       &kp LC(LA(K))  &kp LA(LC(RIGHT))
&trans         &trans             &trans                &trans              &trans         &trans            &trans         &kp LA(LC(PERIOD))  &kp LA(LC(F))  &kp LA(LC(G))
&kp LA(LC(H))  &trans             &trans                &trans              &kp LG(MINUS)  &trans            &trans         &kp LG(PLUS)        &trans         &trans
            >;
        };

        onehand {
            bindings = <
&trans  &mkp MB2        &kp LEFT_GUI  &trans                &trans                 &trans   &trans                 &kp LEFT_GUI          &mkp MB2  &trans
&trans  &trans          &mkp MB1      &kp LG(LEFT_BRACKET)  &trans                 &trans   &kp LG(RIGHT_BRACKET)  &mkp MB1              &trans    &trans
&trans  &trans          &trans        &trans                &trans                 &trans   &trans                 &trans                &trans    &trans
&trans  &bt BT_CLR_ALL  &trans        &trans                &kp LG(RIGHT_BRACKET)  &kp TAB  &kp TAB                &kp LG(LEFT_BRACKET)  &trans    &bt BT_CLR_ALL
            >;
        };
    };
};
