#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        ipad_maximize: ipad_maximize {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp CAPSLOCK &kp F>, <&macro_release>;

            label = "IPAD_MAXIMIZE";
        };

        ipad_left_snap: ipad_left_snap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK &kp LS(LC(LEFT))>,
                <&macro_release>;

            label = "IPAD_LEFT_SNAP";
        };

        ipad_right_snap: ipad_right_snap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK &kp LS(LC(RIGHT))>,
                <&macro_release>;

            label = "IPAD_RIGHT_SNAP";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&ipad_maximize>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&lt 2 Q           &lt 2 W    &kp E    &kp R           &kp T               &kp Y      &kp U                  &kp I               &lt 2 O    &lt 2 P
&lt 1 A           &lt 1 S    &kp D    &mt LEFT_GUI F  &kp G               &kp H      &mt LEFT_GUI J         &kp K               &lt 1 L    &kp BACKSPACE
&mt LEFT_SHIFT Z  &kp X      &kp C    &kp V           &kp B               &mkp MB1   &kp MINUS              &kp N               &kp M      &kp COMMA
&kp DOT           &kp SLASH  &kp TAB  &kp LCTRL       &mt LEFT_GUI LANG2  &kp SPACE  &mt RIGHT_SHIFT ENTER  &mt LEFT_ALT LANG1  &kp GRAVE  &kp ESCAPE
            >;
        };

        symbols {
            bindings = <
&trans          &kp LC(LEFT)  &kp UP        &kp LC(RIGHT)  &kp LC(UP_ARROW)    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1              &kp NUMBER_2  &kp NUMBER_3
&trans          &kp LEFT      &kp DOWN      &kp RIGHT      &kp LC(DOWN)        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NUMBER_4              &kp NUMBER_5  &kp NUMBER_6
&kp LEFT_SHIFT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3        &mkp MB2              &kp EQUAL              &kp SEMICOLON             &kp SQT       &kp NUMBER_7
&kp NUMBER_8    &kp NUMBER_9  &trans        &kp LCTRL      &mt LEFT_GUI LANG2  &kp LG(MINUS)         &kp LG(PLUS)           &mt RIGHT_ALT LANGUAGE_2  &kp NUMBER_0  &kp BACKSLASH
            >;
        };

        screen {
            bindings = <
&trans             &mkp MB1        &trans           &trans            &trans  &kp LA(LC(Z))  &kp LA(LC(X))     &kp LA(LC(C))  &mkp MB1       &trans
&trans             &ipad_maximize  &ipad_left_snap  &ipad_right_snap  &trans  &kp LA(LC(F))  &kp LC(LA(G))     &kp LA(LC(H))  &trans         &trans
&trans             &trans          &trans           &trans            &trans  &trans         &kp LA(LC(LEFT))  &kp LA(LC(J))  &kp LA(LC(L))  &kp LA(LC(K))
&kp LA(LC(RIGHT))  &trans          &trans           &trans            &trans  &trans         &trans            &trans         &trans         &trans
            >;
        };
    };
};
